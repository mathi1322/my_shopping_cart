# Copy to .env and adjust as needed. docker-compose.yml reads these to
# configure the Postgres container and build the app's DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shopping_cart
POSTGRES_PORT=5432
APP_PORT=4321

# Only needed when running the app outside docker compose (e.g. `npm run dev`).
# If POSTGRES_PORT above is already taken on your machine (e.g. by a local
# Postgres install), change POSTGRES_PORT and this port to match, e.g. 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shopping_cart

# The session cookie is marked Secure automatically when the request arrives
# over HTTPS (directly, or via a trusted proxy's X-Forwarded-Proto). Force it
# either way with true/false — e.g. true if TLS terminates at a proxy that
# doesn't send X-Forwarded-Proto.
# COOKIE_SECURE=true

# Public hostname(s) the app is served on, comma-separated (localhost is always
# allowed). Needed for any non-localhost deployment: without it Astro ignores the
# Host header, so same-origin checks fail and client IPs aren't visible.
# ALLOWED_HOSTS=shop.example.com
