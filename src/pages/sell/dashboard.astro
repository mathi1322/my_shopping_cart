---
import Layout from '../../layouts/Layout.astro';
import ProfileTabs from '../../components/ProfileTabs.astro';
import { container } from '../../infrastructure/di/container';
import { orderStatusStyle } from '../../lib/ui/orderStatus';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
if (user.role !== 'seller') {
  return Astro.redirect('/');
}

const dashboard = await container.getSellerDashboard.execute(user.id);

function formatMoney(cents: number, currency = dashboard.currency): string {
  return new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency,
    maximumFractionDigits: 0,
  }).format(cents / 100);
}

// Validated categorical palette (dataviz skill, adjacent-pair CVD-safe order) — one fixed
// color per category NAME, so identity never shifts when ranking/order changes.
const CATEGORY_COLORS: Record<string, string> = {
  'Diagnostic Devices': '#2a78d6',
  'PPE & Masks': '#eb6834',
  'Personal Care & Fitness': '#1baf7a',
  'Mobility & Support': '#eda100',
  'First Aid & Wellness': '#e87ba4',
  Other: '#008300',
};
function categoryColor(category: string): string {
  return CATEGORY_COLORS[category] ?? CATEGORY_COLORS.Other;
}

// --- Revenue trend chart geometry (line + area, sequential single hue) ---
const CHART_W = 760;
const CHART_H = 232;
// top has extra headroom vs bottom/sides — the last point's direct value label sits
// above its dot, and needs room to avoid getting clipped by the SVG viewport edge.
const MARGIN = { top: 28, right: 12, bottom: 28, left: 56 };
const plotW = CHART_W - MARGIN.left - MARGIN.right;
const plotH = CHART_H - MARGIN.top - MARGIN.bottom;

function niceMax(value: number): number {
  if (value <= 0) return 100;
  const magnitude = 10 ** Math.floor(Math.log10(value));
  const normalized = value / magnitude;
  const niceNormalized = normalized <= 1 ? 1 : normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10;
  return niceNormalized * magnitude;
}

const days = dashboard.last14Days;
const maxRevenueRupees = Math.max(...days.map((d) => d.revenueInCents / 100), 0);
const niceMaxRupees = niceMax(maxRevenueRupees);
const niceMaxCents = niceMaxRupees * 100;

const points = days.map((day, i) => ({
  x: MARGIN.left + (i / (days.length - 1)) * plotW,
  y: MARGIN.top + plotH - (niceMaxCents > 0 ? (day.revenueInCents / niceMaxCents) * plotH : 0),
  day,
}));
const linePath = `M ${points.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' L ')}`;
const baselineY = MARGIN.top + plotH;
const areaPath = `${linePath} L ${points[points.length - 1].x.toFixed(1)},${baselineY} L ${points[0].x.toFixed(1)},${baselineY} Z`;

const gridLines = [0, 0.5, 1].map((fraction) => ({
  y: MARGIN.top + plotH - fraction * plotH,
  label: formatMoney(niceMaxCents * fraction),
}));
const tickIndices = [0, Math.floor((days.length - 1) / 2), days.length - 1];

const categoryTotalRevenue = dashboard.categoryBreakdown.reduce(
  (sum, c) => sum + c.revenueInCents,
  0,
);

// Stacked bar segments in a 0–100 coordinate space, with a small gap between them.
const SEGMENT_GAP = 0.4;
let segmentOffset = 0;
const categorySegments = dashboard.categoryBreakdown.map((cat) => {
  const share = categoryTotalRevenue > 0 ? (cat.revenueInCents / categoryTotalRevenue) * 100 : 0;
  const segment = {
    ...cat,
    x: segmentOffset,
    width: Math.max(share - SEGMENT_GAP, 0),
  };
  segmentOffset += share;
  return segment;
});

// --- Top products donut (top 3 by revenue + "Other products") ---
// Fixed slot colors (validated categorical order) — assigned by rank position in
// THIS chart, not carried between page loads, since "top 3" itself can reshuffle
// day to day; "Other products" gets a neutral gray so it never impersonates a real product.
const PRODUCT_SLOT_COLORS = ['#2a78d6', '#eb6834', '#1baf7a'];
const OTHERS_COLOR = '#898781';

const byRevenue = [...dashboard.topProducts].sort((a, b) => b.revenueInCents - a.revenueInCents);
const top3ByRevenue = byRevenue.slice(0, 3);
const top3RevenueSum = top3ByRevenue.reduce((sum, p) => sum + p.revenueInCents, 0);
const top3UnitsSum = top3ByRevenue.reduce((sum, p) => sum + p.unitsSold, 0);
const othersRevenueInCents = Math.max(0, dashboard.totalRevenueInCents - top3RevenueSum);
const othersUnitsSold = Math.max(0, dashboard.totalUnitsSold - top3UnitsSum);

const donutSlices = [
  ...top3ByRevenue.map((product, i) => ({
    label: product.productName,
    productId: product.productId as string | null,
    revenueInCents: product.revenueInCents,
    unitsSold: product.unitsSold,
    color: PRODUCT_SLOT_COLORS[i],
  })),
  ...(othersRevenueInCents > 0
    ? [
        {
          label: 'Other products',
          productId: null as string | null,
          revenueInCents: othersRevenueInCents,
          unitsSold: othersUnitsSold,
          color: OTHERS_COLOR,
        },
      ]
    : []),
];

const DONUT_SIZE = 180;
const DONUT_R = 70;
const DONUT_CENTER = DONUT_SIZE / 2;
const DONUT_STROKE = 28;
const DONUT_CIRC = 2 * Math.PI * DONUT_R;
const DONUT_GAP = donutSlices.length > 1 ? 3 : 0;
const donutTotal = donutSlices.reduce((sum, slice) => sum + slice.revenueInCents, 0);

let donutCumulative = 0;
const donutArcs = donutSlices.map((slice) => {
  const fraction = donutTotal > 0 ? slice.revenueInCents / donutTotal : 0;
  const fullLength = fraction * DONUT_CIRC;
  const dashLength = Math.max(0, fullLength - DONUT_GAP);
  const dashoffset = DONUT_CIRC - donutCumulative;
  donutCumulative += fullLength;
  return {
    ...slice,
    percent: Math.round(fraction * 100),
    dasharray: `${dashLength} ${DONUT_CIRC - dashLength}`,
    dashoffset,
  };
});

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
}
---

<Layout title="Seller Dashboard">
  <h1 class="font-heading mb-4 text-xl font-bold text-slate-800">Dashboard</h1>

  <ProfileTabs active="dashboard" userId={user.id} isSeller={true} />

  {
    dashboard.totalOrders === 0 ? (
      <div class="rounded-2xl border border-blue-200 bg-white p-10 text-center">
        <p class="text-lg font-medium text-slate-700">No orders yet</p>
        <p class="mt-1 text-sm text-slate-500">
          Once buyers start ordering your products, your sales, top products, and revenue trends
          will show up here.
        </p>
        <a
          href="/sell"
          class="bg-brand hover:bg-brand-dark mt-4 inline-block rounded-full px-5 py-2 text-sm font-semibold text-white"
        >
          Manage my products
        </a>
      </div>
    ) : (
      <div class="space-y-4">
        {/* Hero revenue figure + secondary KPI tiles */}
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          <div class="rounded-2xl border border-blue-200 bg-white p-6">
            <p class="text-xs font-semibold text-gray-500 uppercase">Total revenue</p>
            <p class="mt-1 text-[2.75rem] leading-none font-bold text-slate-900">
              {formatMoney(dashboard.totalRevenueInCents)}
            </p>
            {dashboard.revenueDeltaPercent !== null && (
              <p
                class={`mt-2 inline-flex items-center gap-1 text-sm font-medium ${
                  dashboard.revenueDeltaPercent >= 0 ? 'text-[#006300]' : 'text-red-600'
                }`}
              >
                {dashboard.revenueDeltaPercent >= 0 ? '▲' : '▼'}{' '}
                {Math.abs(dashboard.revenueDeltaPercent)}% vs previous 7 days
              </p>
            )}
          </div>

          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:col-span-2">
            <div class="rounded-2xl border border-blue-200 bg-white p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase">Orders</p>
              <p class="mt-1 text-2xl font-bold text-slate-900">{dashboard.totalOrders}</p>
              <p class="mt-1 text-xs text-slate-500">{dashboard.placedOrders} placed</p>
            </div>
            <div class="rounded-2xl border border-blue-200 bg-white p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase">Cancelled</p>
              <p class="mt-1 text-2xl font-bold text-slate-900">{dashboard.cancelledOrders}</p>
              <p class="mt-1 text-xs text-slate-500">
                {dashboard.cancellationRatePercent}% of orders
              </p>
            </div>
            <div class="rounded-2xl border border-blue-200 bg-white p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase">Customers</p>
              <p class="mt-1 text-2xl font-bold text-slate-900">{dashboard.uniqueCustomers}</p>
              <p class="mt-1 text-xs text-slate-500">unique buyers</p>
            </div>
            <div class="rounded-2xl border border-blue-200 bg-white p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase">Avg order value</p>
              <p class="mt-1 text-2xl font-bold text-slate-900">
                {formatMoney(dashboard.averageOrderValueInCents)}
              </p>
            </div>
            <div class="rounded-2xl border border-blue-200 bg-white p-4">
              <p class="text-xs font-semibold text-gray-500 uppercase">Units sold</p>
              <p class="mt-1 text-2xl font-bold text-slate-900">{dashboard.totalUnitsSold}</p>
            </div>
          </div>
        </div>

        {/* Revenue trend + top products */}
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          <div class="rounded-2xl border border-blue-200 bg-white p-4 sm:p-6 lg:col-span-2">
            <h2 class="font-heading mb-3 text-sm font-bold text-gray-600">
              Revenue — last 14 days
            </h2>
            <svg
              viewBox={`0 0 ${CHART_W} ${CHART_H}`}
              class="h-auto w-full"
              role="img"
              aria-label={`Daily revenue for the last 14 days, ${formatMoney(
                points.reduce((sum, p) => sum + p.day.revenueInCents, 0),
              )} in total`}
            >
              {gridLines.map((line) => (
                <>
                  <line
                    x1={MARGIN.left}
                    x2={CHART_W - MARGIN.right}
                    y1={line.y}
                    y2={line.y}
                    stroke="#e1e0d9"
                    stroke-width="1"
                  />
                  <text
                    x={MARGIN.left - 8}
                    y={line.y}
                    text-anchor="end"
                    dy="0.32em"
                    class="fill-slate-400 text-[10px]"
                  >
                    {line.label}
                  </text>
                </>
              ))}
              <path d={areaPath} fill="#2a78d6" fill-opacity="0.1" stroke="none" />
              <path
                d={linePath}
                fill="none"
                stroke="#2a78d6"
                stroke-width="2"
                stroke-linejoin="round"
                stroke-linecap="round"
              />
              {points.map((p) => (
                <circle cx={p.x} cy={p.y} r="4" fill="#2a78d6" stroke="#ffffff" stroke-width="2">
                  <title>
                    {p.day.label}: {formatMoney(p.day.revenueInCents)} ({p.day.placedCount} order
                    {p.day.placedCount === 1 ? '' : 's'})
                  </title>
                </circle>
              ))}
              {points.length > 0 && (
                <text
                  x={points[points.length - 1].x}
                  y={Math.max(points[points.length - 1].y - 10, 10)}
                  text-anchor="end"
                  class="fill-slate-700 text-[11px] font-semibold"
                >
                  {formatMoney(points[points.length - 1].day.revenueInCents)}
                </text>
              )}
              {tickIndices.map((i) => (
                <text
                  x={points[i].x}
                  y={CHART_H - 8}
                  text-anchor="middle"
                  class="fill-slate-400 text-[10px]"
                >
                  {points[i].day.label}
                </text>
              ))}
            </svg>
          </div>

          <div class="rounded-2xl border border-blue-200 bg-white p-4 sm:p-6">
            <h2 class="font-heading mb-3 text-sm font-bold text-gray-600">
              Top products by revenue
            </h2>
            {donutSlices.length === 0 ? (
              <p class="text-sm text-slate-500">No sales yet.</p>
            ) : (
              <>
                <div class="flex justify-center">
                  <svg
                    viewBox={`0 0 ${DONUT_SIZE} ${DONUT_SIZE}`}
                    class="h-40 w-40"
                    role="img"
                    aria-label="Share of revenue by product — values are listed beside the chart"
                  >
                    <circle
                      cx={DONUT_CENTER}
                      cy={DONUT_CENTER}
                      r={DONUT_R}
                      fill="none"
                      stroke="#e1e0d9"
                      stroke-width={DONUT_STROKE}
                    />
                    {donutArcs.map((arc) => (
                      <circle
                        cx={DONUT_CENTER}
                        cy={DONUT_CENTER}
                        r={DONUT_R}
                        fill="none"
                        stroke={arc.color}
                        stroke-width={DONUT_STROKE}
                        stroke-dasharray={arc.dasharray}
                        stroke-dashoffset={arc.dashoffset}
                        transform={`rotate(-90 ${DONUT_CENTER} ${DONUT_CENTER})`}
                      >
                        <title>
                          {arc.label}: {formatMoney(arc.revenueInCents)} ({arc.percent}% ·{' '}
                          {arc.unitsSold} sold)
                        </title>
                      </circle>
                    ))}
                    <text
                      x={DONUT_CENTER}
                      y={DONUT_CENTER - 6}
                      text-anchor="middle"
                      class="fill-slate-400 text-[9px] font-semibold uppercase"
                    >
                      Revenue
                    </text>
                    <text
                      x={DONUT_CENTER}
                      y={DONUT_CENTER + 12}
                      text-anchor="middle"
                      class="fill-slate-900 text-[15px] font-bold"
                    >
                      {formatMoney(donutTotal)}
                    </text>
                  </svg>
                </div>

                <ul class="mt-4 space-y-2">
                  {donutArcs.map((arc) => (
                    <li class="flex items-center gap-2 text-sm">
                      <svg viewBox="0 0 10 10" class="h-2.5 w-2.5 shrink-0" aria-hidden="true">
                        <circle cx="5" cy="5" r="5" fill={arc.color} />
                      </svg>
                      {arc.productId ? (
                        <a
                          href={`/products/${arc.productId}`}
                          class="hover:text-brand min-w-0 flex-1 truncate text-slate-700 hover:underline"
                        >
                          {arc.label}
                        </a>
                      ) : (
                        <span class="min-w-0 flex-1 truncate text-slate-500 italic">
                          {arc.label}
                        </span>
                      )}
                      <span class="shrink-0 text-xs text-slate-500">{arc.unitsSold} sold</span>
                      <span class="w-16 shrink-0 text-right font-semibold text-slate-800">
                        {formatMoney(arc.revenueInCents)}
                      </span>
                      <span class="w-9 shrink-0 text-right text-slate-500">{arc.percent}%</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        </div>

        {/* Category breakdown + recent orders */}
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          <div class="rounded-2xl border border-blue-200 bg-white p-4 sm:p-6">
            <h2 class="font-heading mb-3 text-sm font-bold text-gray-600">Revenue by category</h2>
            {/* SVG rather than styled divs: widths/colours as attributes need no inline styles under the CSP. */}
            <svg
              viewBox="0 0 100 10"
              preserveAspectRatio="none"
              class="h-7 w-full overflow-hidden rounded-full bg-slate-100"
              role="img"
              aria-label="Share of revenue by category — values are listed below"
            >
              {categorySegments.map((segment) => (
                <rect
                  x={segment.x}
                  y="0"
                  width={segment.width}
                  height="10"
                  fill={categoryColor(segment.category)}
                >
                  <title>
                    {segment.category}: {formatMoney(segment.revenueInCents)}
                  </title>
                </rect>
              ))}
            </svg>
            <ul class="mt-4 space-y-2">
              {dashboard.categoryBreakdown.map((cat) => (
                <li class="flex items-center gap-2 text-sm">
                  <svg viewBox="0 0 10 10" class="h-2.5 w-2.5 shrink-0" aria-hidden="true">
                    <circle cx="5" cy="5" r="5" fill={categoryColor(cat.category)} />
                  </svg>
                  <span class="min-w-0 flex-1 truncate text-slate-700">{cat.category}</span>
                  <span class="shrink-0 text-slate-500">
                    {Math.round((cat.revenueInCents / categoryTotalRevenue) * 100)}%
                  </span>
                  <span class="w-24 shrink-0 text-right font-semibold text-slate-800">
                    {formatMoney(cat.revenueInCents)}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-blue-200 bg-white p-4 sm:p-6">
            <h2 class="font-heading mb-3 text-sm font-bold text-gray-600">Recent orders</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-slate-100 text-left text-xs text-slate-500 uppercase">
                    <th class="py-2 pr-2 font-medium">Order</th>
                    <th class="py-2 pr-2 font-medium">Buyer</th>
                    <th class="py-2 pr-2 font-medium">Date</th>
                    <th class="py-2 pr-2 font-medium">Status</th>
                    <th class="py-2 pl-2 text-right font-medium">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  {dashboard.recentOrders.map((order) => (
                    <tr class="border-b border-slate-50 last:border-0">
                      <td class="py-2 pr-2 text-slate-500">#{order.id.slice(0, 8)}</td>
                      <td class="truncate py-2 pr-2 text-slate-700">{order.buyerEmail}</td>
                      <td class="py-2 pr-2 text-slate-500">{formatDate(order.createdAt)}</td>
                      <td class="py-2 pr-2">
                        <span
                          class={`rounded px-2 py-0.5 text-xs font-medium ${orderStatusStyle(order.status).classes}`}
                        >
                          {orderStatusStyle(order.status).label}
                        </span>
                      </td>
                      <td class="py-2 pl-2 text-right font-semibold text-slate-900">
                        {formatMoney(order.totalInCents)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    )
  }
</Layout>
