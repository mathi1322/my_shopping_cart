---
import Layout from '../../layouts/Layout.astro';
import SellerProductManager from '../../components/SellerProductManager';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
if (user.role !== 'seller') {
  return Astro.redirect('/');
}
---

<Layout title="Sell on MediKart">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-xl font-bold text-slate-800">My Products</h1>
    <a
      href={`/?vendorId=${user.id}`}
      class="text-sm font-semibold text-brand hover:underline"
    >
      View my storefront →
    </a>
  </div>
  <SellerProductManager client:load vendorId={user.id} />
</Layout>
