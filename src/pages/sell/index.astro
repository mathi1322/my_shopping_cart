---
import Layout from '../../layouts/Layout.astro';
import ProfileTabs from '../../components/ProfileTabs.astro';
import SellerProductManager from '../../components/SellerProductManager';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
if (user.role !== 'seller') {
  return Astro.redirect('/');
}
---

<Layout title="Sell on MediKart">
  <h1 class="mb-4 font-heading text-xl font-bold text-slate-800">My Products</h1>

  <ProfileTabs active="products" userId={user.id} isSeller={true} />

  <SellerProductManager client:load vendorId={user.id} />
</Layout>
