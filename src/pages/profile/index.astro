---
import Layout from '../../layouts/Layout.astro';
import ProfileSettingsForm from '../../components/ProfileSettingsForm';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const isSeller = user.role === 'seller';
---

<Layout title="My Profile">
  <h1 class="mb-4 font-heading text-xl font-bold text-slate-800">My Profile</h1>

  {
    isSeller && (
      <div class="mb-4 flex gap-2">
        <span class="rounded-full bg-brand px-4 py-2 text-sm font-semibold text-white">
          Settings
        </span>
        <a
          href={`/?vendorId=${user.id}`}
          class="rounded-full border border-blue-200 px-4 py-2 text-sm font-semibold text-brand hover:bg-blue-50"
        >
          My Store
        </a>
      </div>
    )
  }

  <ProfileSettingsForm
    client:load
    isSeller={isSeller}
    initialName={user.name ?? ''}
    initialPhone={user.phone ?? ''}
    initialAddress={user.address ?? ''}
    initialCompanyName={user.companyName ?? ''}
    initialCompanyAddress={user.companyAddress ?? ''}
    initialGstNumber={user.gstNumber ?? ''}
  />
</Layout>
