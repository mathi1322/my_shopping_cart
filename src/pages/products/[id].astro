---
import Layout from '../../layouts/Layout.astro';
import AddToCartControl from '../../components/AddToCartControl';
import { container } from '../../infrastructure/di/container';
import { placeholderTile } from '../../lib/ui/placeholderTile';

const productId = Astro.params.id!;

let product;
try {
  product = await container.getProduct.execute(productId);
} catch {
  return Astro.redirect('/');
}

const reviews = await container.listReviewsForProduct.execute(product.id);

function formatMoney(cents: number, currency: string): string {
  return new Intl.NumberFormat('en-IN', { style: 'currency', currency }).format(cents / 100);
}

const tile = placeholderTile(product.name);
const averageRating = reviews.length
  ? reviews.reduce((sum, review) => sum + review.rating, 0) / reviews.length
  : null;
---

<Layout title={product.name}>
  <nav class="mb-4 flex items-center gap-1.5 text-sm text-slate-500" aria-label="Breadcrumb">
    <a href="/" class="hover:text-brand hover:underline">Home</a>
    <span class="text-slate-300">›</span>
    <a
      href={`/?category=${encodeURIComponent(product.category)}`}
      class="hover:text-brand hover:underline"
    >
      {product.category}
    </a>
    <span class="text-slate-300">›</span>
    <span class="truncate text-slate-700">{product.name}</span>
  </nav>

  <div class="grid grid-cols-1 gap-6 rounded-2xl border border-blue-200 bg-white p-4 sm:grid-cols-2 sm:p-6">
    <div>
      {
        product.images.length > 0 ? (
          <img
            id="gallery-main"
            src={product.images[0]}
            alt={product.name}
            class="aspect-square w-full rounded object-cover"
          />
        ) : (
          <div
            class="flex aspect-square items-center justify-center rounded text-7xl font-bold text-slate-500/70"
            style={{ background: tile.background }}
          >
            {tile.glyph}
          </div>
        )
      }
      {
        product.images.length > 1 && (
          <div class="mt-3 flex gap-2">
            {product.images.map((image, index) => (
              <button
                type="button"
                class={`gallery-thumb aspect-square w-16 shrink-0 overflow-hidden rounded border-2 ${
                  index === 0 ? 'border-brand' : 'border-transparent'
                }`}
                data-src={image}
              >
                <img src={image} alt="" class="h-full w-full object-cover" />
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div class="flex flex-col">
      <h1 class="font-heading text-xl font-semibold text-slate-800 sm:text-2xl">{product.name}</h1>
      {
        averageRating !== null && (
          <p class="mt-1 text-sm text-slate-500">
            <span class="text-amber-500">★</span> {averageRating.toFixed(1)} · {reviews.length}{' '}
            review{reviews.length === 1 ? '' : 's'}
          </p>
        )
      }

      <p class="mt-3 text-2xl font-bold text-slate-900">
        {formatMoney(product.priceInCents, product.currency)}
      </p>

      <div class="mt-2">
        <span
          class={`rounded border px-2 py-1 text-xs font-medium ${
            product.stockQuantity > 0
              ? 'border-green-200 text-green-700'
              : 'border-red-200 text-red-600'
          }`}
        >
          {product.stockQuantity > 0 ? `${product.stockQuantity} in stock` : 'Out of stock'}
        </span>
      </div>
      <p class="mt-1 text-xs text-slate-400">sold by {product.vendorId}</p>

      <p class="mt-4 text-sm leading-relaxed text-slate-600">{product.description}</p>

      {
        product.features.length > 0 && (
          <div class="mt-4">
            <h2 class="mb-2 font-heading text-sm font-semibold text-slate-800">Features</h2>
            <ul class="space-y-1.5 text-sm text-slate-600">
              {product.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="mt-0.5 h-4 w-4 shrink-0 text-brand"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="mt-6 max-w-xs">
        <AddToCartControl
          client:load
          productId={product.id}
          stockQuantity={product.stockQuantity}
          initialLoggedIn={!!Astro.locals.user}
        />
      </div>
    </div>
  </div>

  <div class="mt-6 rounded-2xl border border-blue-200 bg-white p-4 sm:p-6">
    <h2 class="mb-4 font-heading text-lg font-semibold text-slate-800">
      Reviews {reviews.length > 0 && `(${reviews.length})`}
    </h2>
    {
      reviews.length === 0 ? (
        <p class="text-sm text-slate-500">No reviews yet.</p>
      ) : (
        <ul class="space-y-4">
          {reviews.map((review) => (
            <li class="border-b border-slate-100 pb-4 last:border-0 last:pb-0">
              <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-slate-800">{review.authorName}</span>
                <span class="text-sm text-amber-500">
                  {'★'.repeat(review.rating)}
                  {'☆'.repeat(5 - review.rating)}
                </span>
              </div>
              <p class="mt-1 text-sm text-slate-600">{review.comment}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const mainImage = document.getElementById('gallery-main') as HTMLImageElement | null;
        if (mainImage && thumb.dataset.src) {
          mainImage.src = thumb.dataset.src;
        }
        document
          .querySelectorAll('.gallery-thumb')
          .forEach((el) => el.classList.remove('border-brand'));
        document.querySelectorAll('.gallery-thumb').forEach((el) => el.classList.add('border-transparent'));
        thumb.classList.remove('border-transparent');
        thumb.classList.add('border-brand');
      });
    });
  </script>
</Layout>
