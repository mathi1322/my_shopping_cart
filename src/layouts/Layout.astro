---
import '../styles/global.css';
import CartBadge from '../components/CartBadge';
import AuthStatus from '../components/AuthStatus';
import LoginModal from '../components/LoginModal';

interface Props {
  title: string;
  searchQuery?: string;
}

const { title, searchQuery = '' } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · MediKart</title>
  </head>
  <body class="bg-page min-h-full text-slate-900">
    <header class="bg-brand sticky top-0 z-10 shadow-md">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-3 px-4 py-2.5 sm:gap-6 sm:py-2">
        <a href="/" class="font-heading shrink-0 text-xl leading-tight font-bold text-white">
          Medi<span class="text-accent">Kart</span>
        </a>

        <form
          id="filters-form"
          action="/"
          method="get"
          class="order-3 w-full sm:order-2 sm:max-w-xl sm:flex-1"
        >
          <div
            class="focus-within:border-accent flex items-center rounded-full border-2 border-white/0 bg-white px-3 py-2 shadow-sm"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-4 w-4 shrink-0 text-slate-400"
            >
              <path
                fill-rule="evenodd"
                d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z"
                clip-rule="evenodd"></path>
            </svg>
            <input
              type="text"
              name="q"
              value={searchQuery}
              placeholder="Search for products…"
              class="w-full bg-transparent px-2 text-sm text-slate-800 outline-none placeholder:text-slate-400"
            />
          </div>
        </form>

        <nav class="order-2 ml-auto flex items-center gap-1 sm:order-3 sm:gap-2">
          <CartBadge client:load initialLoggedIn={!!user} />
          <AuthStatus
            client:load
            initialUser={user ? { id: user.id, email: user.email, role: user.role } : null}
          />
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-6">
      <slot />
    </main>

    <LoginModal client:load />
  </body>
</html>
